NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# FastAPI backend base URL (server-side only, not exposed to the browser)
PIPSENTRY_API_URL=http://localhost:8000

# Same backend, reachable from the browser (used by client components, e.g.
# the Knowledge Hub's upload form). In production this must be a publicly
# reachable URL, not an internal-only address.
NEXT_PUBLIC_API_URL=http://localhost:8000
