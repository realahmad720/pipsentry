# Postgres (Neon/Supabase in prod, local docker-compose in dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pipsentry

# Qdrant Cloud (local docker-compose in dev)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json

# LLM providers — DeepSeek-R1 for Agents 1-3, Claude Sonnet for Agent 4 (Section 21)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# Embeddings for the Knowledge Hub ingestion pipeline (Section 6)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Market data (Section 3 / Phase 3). The calendar URL default is a real, live
# feed — see app/marketdata/forexfactory.py for why it's not RSS.
TWELVEDATA_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
FOREXFACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Telegram (Phase 6) — one platform bot; users link their own chat via /telegram/link-code
TELEGRAM_BOT_TOKEN=

# Fernet key encrypting Telegram chat ids + connector credentials at rest (Section 11).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Error tracking (Section 13) — inert until set
SENTRY_DSN=

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
